# Keep real credentials only in server/.env. Never use VITE_ variables for these.
OPENCODE_GO_API_KEY=
# WorkBuddy AI quota: on a local machine, the signed-in desktop client is
# synchronized here automatically. On a cloud server, supply the synced values.
WORKBUDDY_ACCESS_TOKEN=
WORKBUDDY_DOMAIN=

# TRAE Work credentials used only by the server. Obtain these from your own
# signed-in client; never use VITE_ prefixes or commit the real values.
TRAE_WORK_ACCESS_TOKEN=
TRAE_WORK_REFRESH_TOKEN=
TRAE_WORK_DEVICE_ID=
TRAE_WORK_TOKEN_EXPIRES_AT=

# ZCode (GLM) start-plan quota. Run `pnpm zcode:login` to fill these in via
# the official CLI OAuth flow. The plan token is stored only here and is never
# sent to the browser. ZCODE_DEVICE_MID is generated once and must stay stable.
ZCODE_PLAN_JWT=
ZCODE_DEVICE_MID=
# Optional overrides for the billing endpoint and reported client version.
#ZCODE_PLAN_ORIGIN=https://zcode.z.ai
#ZCODE_APP_VERSION=3.14.0

PORT=3000
REFRESH_INTERVAL=300000
# rolling, weekly, or monthly. The API returns one normalized Usage object.
OPENCODE_GO_WINDOW=rolling
# Required for every /api/* route except /api/health. Generate a long random
# value and use it only in the server, reverse proxy, and private widgets.
DASHBOARD_TOKEN=
